APP_ENV=production

# RouterAI
ROUTERAI_API_KEY=sk-...
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# Модели по task_type (primary/fallback) — слаги подтверждены через GET /api/v1/models
MODEL_EXTRACTION_PRIMARY=z-ai/glm-5.3-flash
MODEL_EXTRACTION_FALLBACK=deepseek/deepseek-v4-pro-0813
MODEL_FINANCIAL_ANALYSIS_PRIMARY=anthropic/claude-sonnet-5
MODEL_FINANCIAL_ANALYSIS_FALLBACK=deepseek/deepseek-v4-pro-0813

# Reasoning-модели — запас max_tokens на рассуждения (см. app/upstream.py)
REASONING_MODELS=deepseek/deepseek-v4-pro-0813
REASONING_TOKEN_BUFFER=1500

# Auth между сервисами: сгенерировать, напр. `openssl rand -hex 32`
INTERNAL_SECRET=change-me-generate-random-secret

# Allowlist проектов-потребителей (через запятую)
ALLOWED_PROJECTS=cfo-autopilot

# Postgres (request_log)
DATABASE_URL=postgresql+asyncpg://llm_router:change-me@db:5432/llm_router
POSTGRES_PASSWORD=change-me
